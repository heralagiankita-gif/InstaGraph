{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=InstaGraphDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    "SecretKey": "replace-me-with-your-own-key-at-least-64-characters-long-please!",
    "Issuer": "InstaGraph.Api",
    "Audience": "InstaGraph.Client",
    "DurationInMinutes": 480
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:4300"
    ]
  },

  "//Email": [
    "Leave SmtpHost empty and the API writes the confirmation code to its own log instead of sending",
    "it, and tells the sign-up screen it did so. To deliver for real with a Gmail account, set SmtpHost",
    "to smtp.gmail.com, SmtpPort 587, Username to the address and Password to a Google App Password —",
    "not the account password, which Google refuses over SMTP."
  ],

  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "InstaGraph",
    "CodeLifetimeMinutes": 10,
    "TokenLifetimeMinutes": 30,
    "MaxAttempts": 5,
    "MaxSends": 5,
    "ResendCooldownSeconds": 30
  },

  "//Uploads": [
    "SVG is deliberately not on AllowedExtensions. It is the one image format that is also a document:",
    "an SVG can carry script, and these files are served back from the API origin, so accepting one",
    "would be accepting stored script. Every extension here is also checked against the file's leading",
    "bytes in ImageStorage, so renaming a document to .png does not get it in either."
  ],

  "Uploads": {
    "Folder": "uploads",
    "MaxBytes": 8388608,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
    "VideoExtensions": [ ".mp4", ".webm", ".mov", ".m4v" ],
    "MaxVideoBytes": 62914560,
    "MaxMediaPerPost": 10
  },

  "Feed": {
    "AffinityWeight": 3.0,
    "EngagementWeight": 1.0,
    "RecencyWeight": 5.0,
    "RecencyHalfLifeHours": 20.0,
    "SuggestedSlice": 0.25,
    "FavoriteBoost": 2.5,
    "SnapshotCacheSeconds": 20
  },

  "Graph": {
    "AdamicAdarWeight": 1.0,
    "PageRankWeight": 0.8,
    "CircleAuthorityWeight": 0.7,
    "JaccardWeight": 0.5,
    "ReciprocityWeight": 1.1,
    "CommunityWeight": 0.35,
    "PopularityWeight": 0.2,
    "CelebrityPenalty": 0.3,
    "CelebrityFollowers": 10000,
    "CircleOfTrustSize": 50,
    "RestartProbability": 0.25,
    "WalkDepth": 6,
    "MaxPerIntermediary": 2,
    "CandidatePoolSize": 200,
    "NetworkNodeLimit": 90,
    "NewAccountDays": 7,
    "NewAccountFollowers": 1
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*"
}
